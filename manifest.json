{
  "manifest_version": 3,
  "browser_specific_settings": {
    "gecko": {
      "id": "osint-lookup@cjcsecurity.github.io",
      "strict_min_version": "109.0"
    }
  },
  "name": "OSINT Lookup Tool",
  "version": "1.3.1",
  "description": "Quickly check IP addresses, SHA hashes, and domains against popular OSINT platforms",
  "permissions": [
    "activeTab",
    "contextMenus",
    "scripting",
    "tabGroups"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_security_policy": {
    "extension_pages": "default-src 'self'; style-src 'self'; script-src 'self'; object-src 'none'; base-uri 'self'; form-action 'none'"
  }
}
